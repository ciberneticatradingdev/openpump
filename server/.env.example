# Solana RPC (devnet for now). Use Helius/Chainstack in production.
RPC_URL=https://api.devnet.solana.com
# Optional websocket RPC (defaults to RPC_URL with wss)
# RPC_WS_URL=
PORT=8787
# SQLite file (Railway: mount a volume at /data)
DB_PATH=./data/openpump.sqlite
# Where uploaded metadata/images are served from. Pinata if PINATA_JWT is set, else local /uploads.
PUBLIC_URL=http://localhost:8787
# PINATA_JWT=
# Admin wallet (base58 secret or JSON array) for `pnpm admin:init`; never needed by the API itself.
# ADMIN_KEYPAIR=
# Fee recipient for the protocol (defaults to admin pubkey on init)
# FEE_RECIPIENT=
# CORS origin of the web app
WEB_ORIGIN=http://localhost:5173
